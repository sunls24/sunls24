---
import Fade from "@/components/Fade.astro"
import { FADE_DELAY } from "@/lib/constant"
---

<footer class="mt-4">
  <Fade delay={FADE_DELAY * 4}>
    <div class="text-sm text-muted-foreground">
      Built by{" "}
      <a
        target="_blank"
        rel="noopener"
        href="https://astro.build"
        class="font-medium underline underline-offset-2"
      >
        Astro
      </a>
      . The source code is available on{" "}
      <a
        target="_blank"
        rel="noopener"
        href="https://github.com/sunls24/sunls24"
        class="font-medium underline underline-offset-2"
      >
        GitHub
      </a>
      .
    </div>
  </Fade>
</footer>
